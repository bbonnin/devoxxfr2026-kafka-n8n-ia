    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? $json.text ?? \"\";\nlet parsed;\ntry {\n  const clean = raw.replace(/^```json\\s*/i, \"\").replace(/```\\s*$/,\"\").trim();\n  parsed = JSON.parse(clean);\n} catch(e) {\n  // Fallback : extraire le JSON du texte si le LLM a ajouté du texte autour\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error(\"No JSON found in LLM output: \" + raw.substring(0, 200));\n  parsed = JSON.parse(match[0]);\n}\n\n// Valeurs critiques toujours surchargées depuis l'événement source\nconst src = $('Normalisation événement').first().json.event;\nparsed.service  = src.service;\nparsed.env      = src.env;\nparsed.eventId  = src.eventId;\n\n// Valeurs par défaut si le LLM a oublié un champ\nparsed.decision   = (parsed.decision   || \"IGNORE\").toUpperCase();\nparsed.severity   = (parsed.severity   || \"P3\").toUpperCase();\nparsed.confidence = parsed.confidence  ?? 0.5;\nparsed.tools_used = parsed.tools_used  || [];\nparsed.actions    = parsed.actions     || [];\nparsed.rationale  = parsed.rationale   || \"No rationale provided\";\n\n// Valider que decision est dans les valeurs attendues\nconst VALID = [\"IGNORE\",\"ALERT\",\"TICKET\",\"REMEDIATE\"];\nif (!VALID.includes(parsed.decision)) parsed.decision = \"ALERT\";\n\nreturn [{ json: parsed }];\n"
      },
