{
  "name": "Demo-Kafka-Agent_IA-LLM_local",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// On 'normalise' les messages\nconst normalizedMsgs = []\nfor (const item of $input.all()) {\n  const event = item.json.message\n  const endpoint = event?.context?.endpoint || \"\"\n  const fingerprint = [\n    event.service, \n    event.env, \n    event.type, \n    endpoint].filter(Boolean).join(\":\")\n  normalizedMsgs.push({ event, fingerprint})\n}\n\nreturn normalizedMsgs"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "799b0aa6-7e6f-429e-8173-01874b06e1b0",
      "name": "Normalisation événement"
    },
    {
      "parameters": {
        "topic": "events.all",
        "groupId": "n8n-kafka",
        "options": {
          "fromBeginning": false,
          "jsonParseMessage": true
        }
      },
